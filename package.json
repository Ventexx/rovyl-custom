{
  "name": "rovyl",
  "private": true,
  "version": "1.2.8",
  "main": "backend/electron-main.js",
  "author": "HenryCa",
  "description": "Rovyl radial launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ventexx/rovyl-custom.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/verify-radial-windowing.mjs && node scripts/generate-win-icon.mjs",
    "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development node scripts/launch-electron.js",
    "start": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "dist": "npm run build && node scripts/run-electron-builder.mjs",
    "test:win32-launch": "node --test backend/win32-launch.test.cjs",
    "test:persistence-shape": "node scripts/persistence-normalize-smoke.mjs",
    "verify:radial-windowing": "node scripts/verify-radial-windowing.mjs",
    "test": "node --test backend/*.test.cjs && node scripts/persistence-normalize-smoke.mjs && node scripts/verify-radial-windowing.mjs",
    "test:renderer": "node scripts/smoke-renderer.cjs",
    "test:native": "node scripts/smoke-native.cjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "active-win": "^8.2.1",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.292.0",
    "node-global-key-listener": "^0.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "png-to-ico": "^3.0.1",
    "rcedit": "^4.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.2.2",
    "vite": "^8.2.1",
    "wait-on": "^7.1.0"
  },
  "build": {
    "appId": "com.henry.rovyl",
    "productName": "Rovyl",
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "backend/**/*",
      "!backend/*.test.cjs",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "backend/*.ps1",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/active-win/**/*"
    ],
    "directories": {
      "output": "build-out"
    },
    "npmRebuild": false,
    "beforePack": "./scripts/before-build-native.cjs",
    "afterPack": "./scripts/after-pack-win-icon.cjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "uninstallDisplayName": "Rovyl",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "runAfterFinish": true,
      "guid": "5e135f2a-7b3b-4e12-8c14-998822334455",
      "artifactName": "${productName}.${ext}",
      "include": "nsis/installer.nsh",
      "deleteAppDataOnUninstall": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "GPL-3.0-or-later",
  "overrides": {
    "active-win": {
      "@mapbox/node-pre-gyp": "2.0.3",
      "node-gyp": "11.5.0"
    }
  }
}
